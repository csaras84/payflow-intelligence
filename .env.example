# PayPal Sandbox (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_ENVIRONMENT=SANDBOX

# LLM: Azure OpenAI (used when all three AZURE_OPENAI_* values below are set)
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional alternative: Anthropic Claude (used only if Azure is not configured)
# ANTHROPIC_API_KEY=your_anthropic_api_key
# LLM_MODEL=claude-sonnet-5-5

# Database (optional: leave unset to use SQLite)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payflow

# App
CORS_ORIGINS=http://localhost:5173
LIQUIDITY_THRESHOLD=1000
