# PayPal Sandbox (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_ENVIRONMENT=SANDBOX

# LLM (Anthropic Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key
LLM_MODEL=claude-sonnet-5-5

# Database (optional: leave unset to use SQLite)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payflow

# App
CORS_ORIGINS=http://localhost:5173
LIQUIDITY_THRESHOLD=1000
